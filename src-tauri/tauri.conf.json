{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markly",
  "mainBinaryName": "Markly",
  "version": "1.2.0",
  "identifier": "app.markly.viewer",
  "build": {
    "frontendDist": "../dist-web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Markly",
        "width": 1120,
        "height": 820,
        "minWidth": 420,
        "minHeight": 320,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https: http:; media-src 'self' asset: http://asset.localhost https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": { "allow": ["**"], "requireLiteralLeadingDot": false }
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Markly",
    "copyright": "© 2026 Yosef Megrel",
    "category": "Productivity",
    "shortDescription": "A lightweight, beautiful Markdown viewer",
    "longDescription": "Markly opens .md files instantly and renders them beautifully: GitHub-flavored Markdown, tables, code highlighting, math and diagrams, fully offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  }
}
