{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Markly viewer window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:window:allow-show",
    "core:window:allow-close",
    "dialog:allow-open",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ],
      "deny": [
        {
          "path": "**/*.exe"
        },
        {
          "path": "**/*.com"
        },
        {
          "path": "**/*.bat"
        },
        {
          "path": "**/*.cmd"
        },
        {
          "path": "**/*.msi"
        },
        {
          "path": "**/*.msix"
        },
        {
          "path": "**/*.ps1"
        },
        {
          "path": "**/*.vbs"
        },
        {
          "path": "**/*.vbe"
        },
        {
          "path": "**/*.js"
        },
        {
          "path": "**/*.jse"
        },
        {
          "path": "**/*.wsf"
        },
        {
          "path": "**/*.wsh"
        },
        {
          "path": "**/*.hta"
        },
        {
          "path": "**/*.scr"
        },
        {
          "path": "**/*.pif"
        },
        {
          "path": "**/*.cpl"
        },
        {
          "path": "**/*.msc"
        },
        {
          "path": "**/*.jar"
        },
        {
          "path": "**/*.lnk"
        },
        {
          "path": "**/*.reg"
        },
        {
          "path": "**/*.url"
        },
        {
          "path": "**/*.dll"
        },
        {
          "path": "**/*.iso"
        },
        {
          "path": "**/*.vhd"
        },
        {
          "path": "**/*.vhdx"
        },
        {
          "path": "**/*.appref-ms"
        },
        {
          "path": "**/*.application"
        },
        {
          "path": "**/*.inf"
        },
        {
          "path": "**/*.scf"
        }
      ]
    }
  ]
}