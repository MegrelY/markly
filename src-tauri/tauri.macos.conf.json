{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "contentTypes": ["net.daringfireball.markdown"],
        "name": "Markdown Document",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": ["txt", "log", "json", "yaml", "yml", "toml", "ini", "csv", "xml", "html", "htm", "css", "js", "ts", "py"],
        "name": "Text Document",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
